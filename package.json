{
  "name": "dr-sohaib-whatsapp-assistant",
  "version": "1.0.0",
  "description": "Dr. Sohaib WhatsApp appointment and clinic management system.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:demo": "node scripts/seed.js",
    "bootstrap:admin": "node scripts/create-super-admin.js",
    "audit:demo-accounts": "node scripts/audit-demo-accounts.js",
    "migrate:security": "node scripts/migrate-security-indexes.js",
    "audit:appointment-slots": "node scripts/audit-appointment-slots.js",
    "migrate:appointment-engine": "node scripts/migrate-appointment-engine.js",
    "migrate:whatsapp-delivery": "node scripts/migrate-whatsapp-delivery.js",
    "migrate:medical-files": "node scripts/migrate-medical-file-storage.js",
    "migrate:clinic-schedules": "node scripts/migrate-clinic-schedules.js",
    "migrate:notifications-consent-audit": "node scripts/migrate-notifications-consent-audit.js",
    "reconcile:appointment-slots": "node scripts/reconcile-duplicate-slots.js",
    "test": "node --test tests/unit/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test tests/unit/*.test.js",
    "test:integration": "node --test tests/*.integration.test.js",
    "test:appointment-engine": "node --test tests/appointment-engine.test.js",
    "test:appointment-migration": "node --test tests/appointment-migration.test.js",
    "test:whatsapp": "node --test tests/whatsapp.test.js",
    "test:medical-files": "node --test tests/medical-files.test.js",
    "test:schedules": "node --test tests/schedules.test.js",
    "test:notifications": "node --test tests/notifications-consent-audit.test.js",
    "test:production-security": "node --test tests/production-security.test.js",
    "test:recovery": "node --test tests/recovery-readiness.test.js",
    "test:browser": "playwright test",
    "check:syntax": "node scripts/build-check.js",
    "scan:secrets": "node scripts/quality-check.js secrets",
    "scan:dummy": "node scripts/quality-check.js dummy",
    "report:permissions": "node scripts/generate-endpoint-permission-report.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.5.0",
    "mongoose": "^8.6.1",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "openai": "^7.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.4"
  }
}
