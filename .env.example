NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=1

MONGODB_URI=mongodb://127.0.0.1:27017/dr-sohaib-whatsapp-chatbot
# Optional override for hosting providers where the original key is immutable.
MONGODB_URI_V2=

JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
COOKIE_SECRET=your_cookie_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

CLINIC_TIMEZONE=Asia/Karachi
CLINIC_CONTACT_NUMBER=+923000000000
DEFAULT_CLINIC_LOCATION_CODE=BWP
PUBLIC_WHATSAPP_NUMBER=+923000000000
APPOINTMENT_CONSENT_TEXT=The clinic will use your information for appointment management, reminders, rescheduling, and clinic communications.
APPOINTMENT_CONSENT_VERSION=appointment-consent-v1

WHATSAPP_GRAPH_VERSION=v20.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_TEMPLATE_APPOINTMENT_CONFIRMATION=dr_sohaib_appointment_confirmation
WHATSAPP_TEMPLATE_APPOINTMENT_CONFIRMATION_LANGUAGE=en_US
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER=dr_sohaib_appointment_reminder_v1
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER_LANGUAGE=en_US
WHATSAPP_TEMPLATE_RESCHEDULE_CONFIRMATION=dr_sohaib_reschedule_confirmation_v1
WHATSAPP_TEMPLATE_RESCHEDULE_CONFIRMATION_LANGUAGE=en_US
WHATSAPP_TEMPLATE_CANCELLATION_CONFIRMATION=cancellation_confirmation
WHATSAPP_TEMPLATE_CANCELLATION_CONFIRMATION_LANGUAGE=en_US
WHATSAPP_TEMPLATE_ARRIVAL_UPDATE=
WHATSAPP_TEMPLATE_ARRIVAL_UPDATE_LANGUAGE=en_US

EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=notifications@clinic.example
OWNER_EMAIL=owner@clinic.example
EMAIL_SECURE=false

EMAIL_FROM_NAME=Dr. Sohaib Clinic
ADMIN_PANEL_URL=http://localhost:3000/#/admin

# Private medical-file storage. Production must use "s3".
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_MAX_UPLOAD_BYTES=10485760
STORAGE_SIGNED_URL_EXPIRY_SECONDS=300
STORAGE_LOCAL_PATH=private-storage

# Hybrid AI concierge (never place real keys in source control)
AI_CONCIERGE_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TIMEOUT_MS=12000
OPENAI_MAX_RETRIES=1
AI_RATE_LIMIT_PER_MINUTE=20
WHATSAPP_AUDIO_MAX_BYTES=8388608
WHATSAPP_DOCTOR_WELCOME_MEDIA_ID=
CLINIC_EMERGENCY_MESSAGE=
